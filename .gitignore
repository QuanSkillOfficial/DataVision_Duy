.DS_Store
Thumbs.db

# Runtime logs
*.log
logs/runs/*.json
logs/manifests/*_manifest.json
outputs/integration/week7_backend_stub_smoke_result.json

# Local audit inputs. These are independent repositories/reference tasks and
# must never be committed recursively into the shared platform repository.
/team_repositories/
/weekly_tasks/

# DV-HUNG-07: staging reviewer credentials must never be committed.
deployment/staging/htpasswd

# DV-HUNG-01/02/03: Week 8 UI evidence is produced by CI and uploaded as a
# build artifact, not committed.
outputs/week8/

# Generated backup artifacts — never commit, only .gitkeep stays tracked
week8/database/outputs/backups/*.dump
week8/database/outputs/backups/*.dump.sha256
week8/database/outputs/backups/backup_manifest.json
