__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.pytest_runtime_tmp/
.ci_runtime_tmp/

# Virtual environments
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# Editors and OS files
.vscode/
