# Copy this file to .env for local development. Do not commit real secrets.

COMPOSE_PROJECT_NAME=datavision

# PostgreSQL + pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datavision_db
DB_USER=datavision
DB_PASSWORD=datavision123
POSTGRES_USER=datavision
POSTGRES_PASSWORD=datavision123
POSTGRES_DB=datavision_db

# Backend contract stub
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000/api

# UI defaults used by the shared contract
QS_USE_BACKEND=false
UI_PORT=8501
UI_IMAGE=datavision-ui:week7-local

# Optional sibling-repository discovery for readiness reports
TEAM_REPOS_ROOT=..
