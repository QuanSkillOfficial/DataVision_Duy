# Copy this file to .env for local development. Do not commit real secrets.

COMPOSE_PROJECT_NAME=datavision-week8-local

# PostgreSQL + pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datavision_db
DB_USER=datavision
DB_PASSWORD=datavision123
POSTGRES_USER=datavision
POSTGRES_PASSWORD=datavision123
POSTGRES_DB=datavision_db

# Backend staging API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000/api
DATAVISION_BACKEND_MODE=staging
RAG_EMBEDDING_MODE=hash

# UI defaults used by the shared contract
QS_USE_BACKEND=true
QS_BACKEND_URL=http://backend:8000/api
UI_PORT=8501
UI_IMAGE=datavision-ui:week8-staging

# Owner modules are merged into the canonical root. This is only needed when
# auditing historical standalone repositories.
TEAM_REPOS_ROOT=

# Optional override used by the local Duy-to-Phat integration runner.
PHAT_SCHEMA_PATH=deployment/database/init/10_phat_schema_v4_fixed.sql
