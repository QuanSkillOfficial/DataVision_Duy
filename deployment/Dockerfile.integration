FROM python:3.11-slim

WORKDIR /app

COPY requirements-ci.txt /app/requirements-ci.txt
COPY ai/rag/requirements-ci.txt /app/ai/rag/requirements-ci.txt
COPY ai/prediction/requirements-ci.txt /app/ai/prediction/requirements-ci.txt
RUN pip install --no-cache-dir \
    -r /app/requirements-ci.txt \
    -r /app/ai/rag/requirements-ci.txt \
    -r /app/ai/prediction/requirements-ci.txt

RUN groupadd --gid 10001 datavision \
    && useradd --uid 10001 --gid datavision --create-home datavision

COPY --chown=datavision:datavision data_engineering /app/data_engineering
COPY --chown=datavision:datavision ai /app/ai
COPY --chown=datavision:datavision backend_stub /app/backend_stub
COPY --chown=datavision:datavision scripts /app/scripts
COPY --chown=datavision:datavision week7 /app/week7
COPY --chown=datavision:datavision deployment /app/deployment
COPY --chown=datavision:datavision logs/runs /app/logs/runs
COPY --chown=datavision:datavision outputs /app/outputs
COPY --chown=datavision:datavision week2/data /app/week2/data
COPY --chown=datavision:datavision week2/logs /app/week2/logs
COPY --chown=datavision:datavision data_engineering/configs /app/data_engineering/configs

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV RAG_EMBEDDING_MODE=hash

USER datavision

CMD ["python", "scripts/week8_seed_staging.py"]
