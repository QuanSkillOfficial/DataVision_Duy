FROM python:3.11-slim

WORKDIR /app

COPY requirements-ci.txt /app/requirements-ci.txt
COPY ai/rag/requirements-ci.txt /app/ai/rag/requirements-ci.txt
COPY ai/prediction/requirements-ci.txt /app/ai/prediction/requirements-ci.txt
RUN pip install --no-cache-dir \
    -r /app/requirements-ci.txt \
    -r /app/ai/rag/requirements-ci.txt \
    -r /app/ai/prediction/requirements-ci.txt

COPY data_engineering /app/data_engineering
COPY ai /app/ai
COPY backend_stub /app/backend_stub
COPY scripts /app/scripts
COPY week7 /app/week7
COPY deployment /app/deployment
COPY logs/runs /app/logs/runs
COPY outputs /app/outputs
COPY week2/data /app/week2/data
COPY week2/logs /app/week2/logs
COPY data_engineering/configs /app/data_engineering/configs

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV RAG_EMBEDDING_MODE=hash

CMD ["python", "scripts/week8_seed_staging.py"]
